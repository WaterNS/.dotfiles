#!/bin/sh
# Disable the Mac keyboard Do-Not-Disturb keyboard button (half-moon icon on F6 key)

# Decimal values keep the payload valid JSON.
src=4294967451   # 0x10000009B: Do-Not-Disturb button
dst=30064771072  # 0x700000000: No Key

#Key:
# 0x70000003F = F6 Button
# 0x10000009B = Do-Not-Disturb button
# 0x700000000 = No Key

# jq is installed by init_posix; launchd does not inherit the shell's PATH.
repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P) || exit 1
jq_command=$(command -v jq)
if [ -z "$jq_command" ]; then
  for candidate in "$repo_dir/opt/bin/jq" "$repo_dir/opt/homebrew/bin/jq" /opt/homebrew/bin/jq /usr/local/bin/jq; do
    if [ -x "$candidate" ]; then
      jq_command=$candidate
      break
    fi
  done
fi
if [ -z "$jq_command" ]; then
  echo 'mac-KbDisableDndButton: jq is unavailable; rerun init_posix.sh.' >&2
  exit 1
fi

# Read and validate existing mappings before changing anything. OpenStep plists
# can encode the HID numbers as strings, so normalize both fields numerically.
plist=$(hidutil property --get "UserKeyMapping") || exit 1
if [ "$plist" = "(null)" ]; then
  current_json="[]"
else
  current_json=$(printf '%s\n' "$plist" | plutil -convert json -o - -) || exit 1
fi
current_json=$(printf '%s\n' "$current_json" | "$jq_command" -ce '
  if type != "array" then error("UserKeyMapping must be an array")
  else map(
    .HIDKeyboardModifierMappingSrc |= tonumber |
    .HIDKeyboardModifierMappingDst |= tonumber
  ) end
') || exit 1

# A single mapping with the correct source AND destination needs no write.
# shellcheck disable=SC2016 # $src/$dst are jq variables supplied by --argjson.
if printf '%s\n' "$current_json" | "$jq_command" -e --argjson src "$src" --argjson dst "$dst" '
  map(select(.HIDKeyboardModifierMappingSrc == $src)) |
  length == 1 and .[0].HIDKeyboardModifierMappingDst == $dst
' >/dev/null; then
  exit 0
fi

# Replace stale/duplicate mappings for this key while preserving other keys.
# shellcheck disable=SC2016 # $src/$dst are jq variables supplied by --argjson.
new_json=$(printf '%s\n' "$current_json" | "$jq_command" -c --argjson src "$src" --argjson dst "$dst" '
  {UserKeyMapping: (map(select(.HIDKeyboardModifierMappingSrc != $src)) + [{
    HIDKeyboardModifierMappingSrc: $src,
    HIDKeyboardModifierMappingDst: $dst
  }])}
') || exit 1
hidutil property --set "$new_json" >/dev/null || exit 1
echo 'Remapped: Do-Not-Disturb (F6) button -> No Key/No Action'

## Check the mappings:
#hidutil property --get "UserKeyMapping"

## Clear the mappings:
#hidutil property --set '{"UserKeyMapping":[]}'
